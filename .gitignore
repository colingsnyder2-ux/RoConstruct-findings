# Client files are proprietary: only the registry, sources, and docs are tracked.
clients/*
!clients/README.md
!clients/clients.json
!clients/sources.json

# Matched-source findings are published separately from proprietary client
# payloads. Keep binaries and local client folders ignored; track src/ when
# explicitly included in a findings release.

# Local runtime state and output
work/
tools/
*.db
*.log
roconstruct-settings.json

# Old pre-rewrite scripts, kept on disk until the port is done
scripts/

# Python / build
__pycache__/
*.pyc
build/
dist/
*.spec
